<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_card_bg"
    android:gravity="top|start">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Budget Progress"
        android:textColor="#49454F"
        android:textSize="11sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Food &amp; Groceries"
        android:textColor="#1C1B1F"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp" />

    <ProgressBar
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="8dp"
        style="?android:attr/progressBarStyleHorizontal"
        android:progress="40"
        android:progressTint="#6750A4"
        android:progressBackgroundTint="#E7E0EC" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$ 200 / $ 500  (40%)"
        android:textColor="#1C1B1F"
        android:textSize="11sp"
        android:layout_marginTop="6dp" />

</LinearLayout>
